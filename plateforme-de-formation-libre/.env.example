# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://tadribi.chtbqi.com"

# NARDOPAY (Server-side ONLY — never expose NARDOPAY_API_KEY or NARDOPAY_WEBHOOK_SECRET to frontend)
NARDOPAY_API_KEY=
NARDOPAY_WEBHOOK_SECRET=
NARDOPAY_BASE_URL="https://nardopay.com"
NARDOPAY_WIDGET_URL="https://nardopay.com/widget/nardopay-widget.js"

# SMTP / Email Delivery (Server-side ONLY — use App Password / SMTP credentials in secret store)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM="Tedribi <no-reply@tadribi.chtbqi.com>"
SMTP_WEBHOOK_URL=

# Auth / Session Security
SESSION_SECRET=
RESET_SECRET=
RECEIPT_HMAC_SECRET=
SESSION_INACTIVITY_DAYS=5

# Database (SQLite default; set DATABASE_URL for PostgreSQL pool readiness)
DATABASE_URL=

# Object Storage (S3 / Cloudflare R2 compatible — falls back to confined local disk if unset)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# VITE_API_BASE_URL: Production backend URL injected at Vite build time.
VITE_API_BASE_URL="https://api.tadribi.chtbqi.com"

# CORS_ORIGINS: Comma-separated allowed frontend origins for Express CORS.
CORS_ORIGINS="https://tadribi.chtbqi.com,https://b495be73.tedribi.pages.dev"


