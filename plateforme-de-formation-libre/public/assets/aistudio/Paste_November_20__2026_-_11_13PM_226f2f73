<script type="text/javascript">
    // px of slack for the native dropdown arrow (chunkier on mobile)
    var DDL_ARROW_SLACK = 24;
    // viewport width at or below which we swap in the short labels
    var DDL_MOBILE_MAX = 640;
    // captured once on first run: value -> { full: '...', short: '...' }
    var DDL_LABELS = {};

    function changeddwidth() {
        var $ddl = $('#ctl00_search1_ddlSearchCategory');
        var $tmp = $("#width_tmp_select");
        if (!$ddl.length || !$tmp.length) { return; }

        // capture the server-rendered (full) labels once, then define short forms
        // for the two that don't fit a phone header. Only the TEXT changes --
        // option values stay 'healthcare' / 'kitchen', so btnSearch_Click is unaffected.
        if ($.isEmptyObject(DDL_LABELS)) {
            $ddl.find('option').each(function () {
                DDL_LABELS[this.value] = { full: $(this).text() };
            });
            if (DDL_LABELS['healthcare']) { DDL_LABELS['healthcare'].short = 'العناية الشخصية'; }
            if (DDL_LABELS['kitchen'])    { DDL_LABELS['kitchen'].short    = 'المطبخ'; }
        }

        var mobile = $(window).width() <= DDL_MOBILE_MAX;
        $ddl.find('option').each(function () {
            var m = DDL_LABELS[this.value];
            if (!m) { return; }
            $(this).text(mobile && m.short ? m.short : m.full);
        });

        // mirror must render with the SAME typography as the real select,
        // otherwise it measures short (mobile browsers restyle form controls)
        $tmp.css({
            fontFamily: $ddl.css('font-family'),
            fontSize: $ddl.css('font-size'),
            fontWeight: $ddl.css('font-weight'),
            letterSpacing: $ddl.css('letter-spacing'),
            padding: 0
        });

        $("#width_tmp_option").text($ddl.find('option:selected').text());
        $ddl.width($tmp.width() + DDL_ARROW_SLACK);

        var $box = $('.searchTextBox'),
            $btn = $('.buttonSearch'),
            avail = $ddl.parent().width() - $ddl.outerWidth(true) - $btn.outerWidth(true) - 4;
        if (avail > 40) { $box.outerWidth(avail); }
    }

    $(document).ready(function () {
        $('#ctl00_search1_ddlSearchCategory').change(changeddwidth);
        changeddwidth();   // size correctly on initial load / after search redirect

        // re-run on rotate / resize so labels swap when crossing the breakpoint
        var ddlResizeTimer = null;
        $(window).on('resize orientationchange', function () {
            clearTimeout(ddlResizeTimer);
            ddlResizeTimer = setTimeout(changeddwidth, 150);
        });
    });
</script>
