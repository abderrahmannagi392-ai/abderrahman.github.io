         <script type="text/javascript">
            $(function () {
                var $btn = $('#nwfNewsBtn'),
                    $email = $('#nwfNewsEmail'),
                    $msg = $('#nwfNewsMsg'),
                    $cnt = $('#ctl00_footer1_ddCountry');

                function setMsg(t, c) {
                    $msg.removeClass('nwfOk nwfErr').addClass(c || '').text(t);
                }

                function submit() {
                    var em = $.trim($email.val());
                    var cn = $.trim($cnt.val());

                    if (em.length < 5 || em.indexOf('@') < 1 || em.indexOf('.') < 0) {
                        setMsg('الرجاء التأكد من البريد الإلكتروني', 'nwfErr');
                        $email.focus();
                        return;
                    }

                    if (cn === '') {
                        setMsg('الرجاء اختيار الدولة', 'nwfErr');
                        $cnt.focus();
                        return;
                    }

                    $btn.prop('disabled', true);
                    setMsg('جارٍ الاشتراك...', '');

                    $.ajax({
                        type: 'POST',
                        url: '/newslettersubscribe.asmx/subscribe',
                        data: JSON.stringify({ email: em, hp: $('#nwfNewsHp').val(), country: cn }),
                        contentType: 'application/json; charset=utf-8',
                        dataType: 'json',
                        success: function (r) {
                            $btn.prop('disabled', false);
                            if (r.d === 'ok') {
                                $('#nwfNewsRow').hide();
                                setMsg('تم اشتراكك بنجاح، شكراً لك', 'nwfOk');
                            } else if (r.d === 'bad') {
                                setMsg('الرجاء التأكد من البريد الإلكتروني', 'nwfErr');
                            } else if (r.d === 'nocountry') {
                                setMsg('الرجاء اختيار الدولة', 'nwfErr');
                            } else if (r.d === 'slow') {
                                setMsg('تم إرسال عدة طلبات، الرجاء المحاولة لاحقاً', 'nwfErr');
                            } else if (r.d === 'cantsub') {
                                setMsg('تعذّر الاشتراك بهذا البريد، الرجاء التواصل معنا', 'nwfErr');
                            } else {
                                setMsg('تعذّر إتمام الاشتراك، الرجاء المحاولة لاحقاً', 'nwfErr');
                            }
                        },
                        error: function () {
                            $btn.prop('disabled', false);
                            setMsg('تعذّر إتمام الاشتراك، الرجاء المحاولة لاحقاً', 'nwfErr');
                        }
                    });
                }

                $btn.on('click', submit);

                $email.on('keydown', function (e) {
                    if (e.which === 13) { e.preventDefault(); submit(); }
                });
            });
        </script>
