                titletext = "Shipping from UAE Store (" + amount + ")";                                
                title = titletext;
                content2 = " UAE store ";
            } else if (center == "ae" && from == 1){
                titletext = "Shipping from other Stores (" + amount + ")";
                title = titletext;
                content2 = " other stores ";
            }                      
